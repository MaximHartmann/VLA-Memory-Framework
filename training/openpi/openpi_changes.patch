+# Weight guard. The A4000 red_blue runs corrupt early, at step 8-24:
+#   - 4 GPUs: Adam's first moment for a few elements of action_in_proj/bias and
+#     time_mlp_in/bias was overwritten with ~1e27, and the weights followed.
+#   - 2 GPUs: a SigLIP bias went NaN; in another run the loss jumped 5x with an
+#     infinite gradient norm.
+# param_norm above skips biases, so the logs never showed the first kind, and
+# those runs trained on garbage for hours.
+#
+# After every step the guard checks the loss, the gradient norm and the largest
+# |value| of every parameter array, frozen ones included. It aborts (exit code
+# 3) on any non-finite value, or on any array above its limit: max(OPENPI_WEIGHT_GUARD,
+# 2 x the array's max at the start), capped at 1e6. pi05_base's SigLIP biases
+# reach 67, so a flat limit would fire at once. The cap still catches a run
+# resumed from an already-corrupted checkpoint. AdamW moves a weight by well
+# under 1 over a whole run, so real training never reaches a limit.
+#
+# Results are read only when they are already on the host, or in bulk at each
+# log step, so the guard adds no host sync. OPENPI_WEIGHT_GUARD=0 turns it off.
+WEIGHT_GUARD = float(os.environ.get("OPENPI_WEIGHT_GUARD", "10.0"))
+GUARD_EXIT_CODE = 3
+
+
+def _param_arrays(params: nnx.State) -> dict[str, at.Array]:
+    flat = traverse_util.flatten_dict(params.to_pure_dict())
+    return {"/".join(map(str, k)): v for k, v in flat.items()}
+
+
+@jax.jit
+def _absmax(arrays: dict[str, at.Array]) -> dict[str, at.Array]:
+    # Reduce in each array's own dtype and cast only the scalar, so no fp32 copy of the embedding.
+    return {k: jnp.max(jnp.abs(v)).astype(jnp.float32) for k, v in arrays.items()}
+
+
+def _guard_limits(params: nnx.State) -> dict[str, float]:
+    start = jax.device_get(_absmax(_param_arrays(params)))
+    return {k: min(max(WEIGHT_GUARD, 2 * float(v)), 1e6) for k, v in start.items()}
+
+
+def _check_guard(
+    pending: list[tuple[int, dict[str, at.Array], dict[str, at.Array]]], limits: dict[str, float], *, wait: bool
+) -> float:
+    """Check queued per-step results in step order; consumed entries are removed from `pending`.
+
+    Each entry is (step, per-array max |value|, the step's info dict). Without `wait`, stops at the
+    first entry still being computed. Returns the worst value/limit ratio among the checked entries,
+    and exits the process if any entry has a non-finite value or breaks a limit.
+    """
+    worst = 0.0
+    while pending:
+        step, absmax, info = pending[0]
+        if not wait and not all(v.is_ready() for v in (*absmax.values(), *info.values())):
+            break
+        pending.pop(0)
+        bad = [f"{k} = {float(v):.4g}" for k, v in jax.device_get(info).items() if not np.isfinite(float(v))]
+        for name, value in jax.device_get(absmax).items():
+            value = float(value)
+            if not np.isfinite(value) or value > limits[name]:
+                bad.append(f"max |{name}| = {value:.4g} (limit {limits[name]:.4g})")
+            else:
+                worst = max(worst, value / limits[name])
+        if bad:
+            logging.error(f"WEIGHT GUARD: after step {step}: {'; '.join(bad[:5])}. Training is corrupted; aborting.")
+            raise SystemExit(GUARD_EXIT_CODE)
+    return worst
+
