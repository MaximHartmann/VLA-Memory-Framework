+def _accumulated_value_and_grad(
+    config: _config.TrainConfig,
+    state: training_utils.TrainState,
+    rng: at.KeyArrayLike,
+    observation: _model.Observation,
+    actions: _model.Actions,
+) -> tuple[at.Array, nnx.State]:
+    """Mean loss and gradient over config.grad_accum_steps micro-batches, run one at a time.
+
+    The micro-batches go through a lax.scan, so only one micro-batch's activations are live at a
+    time; the gradient sum is kept in float32. Each micro-batch draws its own flow-matching noise and
+    time from fold_in(rng, i). The result has the same structure as the single-batch gradient.
+    """
+    k = config.grad_accum_steps
+    trainable = state.params.filter(config.trainable_filter)
+    frozen = state.params.filter(nnx.Not(config.trainable_filter))
+
+    def micro_loss(trainable, rng, observation, actions):
+        model = nnx.merge(state.model_def, trainable, frozen)
+        model.train()
+        return jnp.mean(model.compute_loss(rng, observation, actions, train=True))
+
+    def body(carry, xs):
+        loss_sum, grad_mean = carry
+        (observation, actions), i = xs
+        loss, grads = jax.value_and_grad(micro_loss)(trainable, jax.random.fold_in(rng, i), observation, actions)
+        # Scale inside the loop so the carry already holds the mean: no separate averaged copy of the
+        # gradients after the scan (each copy is ~1.7 GiB for pi05 LoRA).
+        return (loss_sum + loss, jax.tree.map(lambda m, g: m + g / k, grad_mean, grads)), None
+
+    micro = jax.tree.map(lambda x: x.reshape(k, x.shape[0] // k, *x.shape[1:]), (observation, actions))
+    init = (jnp.zeros((), jnp.float32), jax.tree.map(jnp.zeros_like, trainable))
+    (loss_sum, grad_mean), _ = jax.lax.scan(body, init, (micro, jnp.arange(k)))
+    return loss_sum / k, grad_mean
+
+
